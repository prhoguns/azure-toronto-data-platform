{
  "name": "ds_bronze_csv",
  "properties": {
    "linkedServiceName": { "referenceName": "ls_adls_lake", "type": "LinkedServiceReference" },
    "parameters": { "table": { "type": "string" }, "runDate": { "type": "string" }, "fileName": { "type": "string" } },
    "type": "DelimitedText",
    "typeProperties": {
      "location": {
        "type": "AzureBlobFSLocation",
        "fileSystem": "bronze",
        "folderPath": { "value": "@concat(dataset().table, '/', dataset().runDate)", "type": "Expression" },
        "fileName": { "value": "@dataset().fileName", "type": "Expression" }
      },
      "columnDelimiter": ",",
      "quoteChar": "\"",
      "escapeChar": "\"",
      "firstRowAsHeader": true
    }
  }
}
